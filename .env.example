DISCORD_TOKEN=replace-me
DISCORD_CLIENT_ID=replace-me

# Optional. When set, slash commands deploy instantly to this guild.
# Without this, npm run deploy:commands registers global commands.
DISCORD_GUILD_ID=

# Generic role for anyone linked by EarthMC or EarthPol.
LINKED_ROLE_ID=1507122558473080862
LINKED_ROLE_NAME=Linked
# Source-specific linked roles.
LINKED_BY_EMC_ROLE_ID=1507128585633140927
LINKED_BY_EMC_ROLE_NAME=Linked By EMC
LINKED_BY_EPMC_ROLE_ID=1507128672606228681
LINKED_BY_EPMC_ROLE_NAME=Linked By EPMC

# Local link cache path.
LINK_STORE_PATH=data/links.json

# Sync behavior.
SYNC_ON_READY=true
SYNC_INTERVAL_MINUTES=360
SYNC_BATCH_SIZE=50
SYNC_BOTS=false

# Optional: set true if you want failed API lookups to remove linked roles.
# Default false avoids removing roles during API gaps or opt-outs.
SYNC_REMOVE_UNLINKED=false
